---
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Concertagenda van de grote zalen in Nederland, België en Duitsland." />
    <meta name="theme-color" content="#eceee9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1233" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/data/agenda.json" as="fetch" crossorigin="anonymous" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
