// Cloudflare: the site is plain static files (Astro "static" output in dist/), served as Workers static assets.
// With this file present, `npx wrangler deploy` uploads dist/ as-is and does not try to convert the project
// (its automatic "astro add cloudflare" step broke the build on 26 Nov 2026).
// Phase 3 (B42): a small Worker script answers /api/* only (link code → list of followed artists, in D1).
// Every other request is a static file and never runs the script (free and unlimited, BRONNEN.md).
// The D1 database has no id here on purpose: on the first deploy Cloudflare creates it ("automatic resource
// provisioning", Wrangler ≥ 4.45) and keeps the id in the dashboard. No secrets.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "podiumradar",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.ts",
  // Serve the site on <name>.<account>.workers.dev (otherwise the dashboard shows "no URL enabled").
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "podiumradar-sync" }]
}
